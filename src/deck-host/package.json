{
  "name": "deck-host",
  "version": "0.13.0",
  "description": "Hôte propriétaire du cockpit NinjaTrader — remplace l'application Stream Deck d'Elgato",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/emit-shared.mjs && tsc",
    "emit:check": "node scripts/emit-shared.mjs --check",
    "watch": "tsc --watch",
    "start": "node dist/host.js",
    "dev": "tsc && node dist/host.js",
    "typecheck": "tsc --noEmit",
    "build:bridge": "dotnet publish ../StreamDeckBridge/StreamDeckBridge.csproj -c Release -o bridge",
    "build:all": "npm run build:bridge && npm run build"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "@resvg/resvg-js": "^2.6.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  }
}

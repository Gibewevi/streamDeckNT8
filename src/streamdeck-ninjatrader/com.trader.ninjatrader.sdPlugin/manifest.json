{
  "UUID": "com.trader.ninjatrader",
  "Name": "NinjaTrader Trading Cockpit",
  "Version": "1.0.0",
  "Author": "StreamDeck Trader",
  "Description": "Professional trading cockpit for NinjaTrader 8",
  "Icon": "imgs/plugin-icon",
  "Category": "NinjaTrader",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "dist/plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Buy Market",
      "UUID": "com.trader.ninjatrader.buymarket",
      "Icon": "imgs/actions/buy-market",
      "Tooltip": "Submit a market buy order",
      "Controllers": ["Keypad"],
      "States": [
        { "Image": "imgs/actions/buy-market", "TitleAlignment": "middle", "FontSize": "12", "ShowTitle": false }
      ],
      "PropertyInspectorPath": "ui/action-settings.html"
    },
    {
      "Name": "Sell Market",
      "UUID": "com.trader.ninjatrader.sellmarket",
      "Icon": "imgs/actions/sell-market",
